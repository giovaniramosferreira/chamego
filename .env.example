# Mercado Pago — Access Token (Suas integrações > credenciais). Use TEST- em sandbox.
MP_ACCESS_TOKEN=

# Google Cloud — chave com Places API (New) habilitada. Só vive no servidor.
GOOGLE_MAPS_API_KEY=

# Anthropic — textos românticos (carta, sinastria, cupido, score). Sem ela: fallbacks.
ANTHROPIC_API_KEY=

# OpenAI — transcrição Whisper do áudio do casal (opcional).
OPENAI_API_KEY=

# URL pública do app (ex: https://chamego.onrender.com) — webhook e links.
PUBLIC_URL=

# Diretório persistente para SQLite + uploads (no Render: /var/data).
DATA_DIR=
