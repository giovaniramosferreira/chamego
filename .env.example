# URL pública do app (ex: https://chamego.onrender.com) — links de convite e link mágico.
PUBLIC_URL=

# Diretório persistente para o SQLite (no Render: /var/data).
DATA_DIR=

# Segredo que assina o cookie de sessão. Sem ele, todo deploy desloga todo mundo.
SESSION_SECRET=

# Google Identity Services — botão "Continuar com Google". Sem ele, só link mágico.
GOOGLE_CLIENT_ID=

# --- Email do link mágico (SMTP genérico, ex: Resend) ---
# Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key re_...>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Remetente exibido. Precisa ser do domínio verificado. Ex: "Chamego <ola@chamego.online>"
MAIL_FROM=

# Gmail legado (fallback se SMTP_* vazio). Mantido por compatibilidade.
GMAIL_USER=
GMAIL_APP_PASSWORD=
