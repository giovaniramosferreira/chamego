# Mercado Pago — Access Token (Suas integrações > credenciais). Use TEST- em sandbox.
MP_ACCESS_TOKEN=

# Google Cloud — chave com Places API (New) habilitada. Só vive no servidor.
GOOGLE_MAPS_API_KEY=

# Anthropic — textos românticos (carta, sinastria, cupido, score). Sem ela: fallbacks.
ANTHROPIC_API_KEY=

# OpenAI — transcrição Whisper do áudio do casal (opcional).
OPENAI_API_KEY=

# URL pública do app (ex: https://chamego.onrender.com) — webhook e links.
PUBLIC_URL=

# Diretório persistente para SQLite + uploads (no Render: /var/data).
DATA_DIR=

# Cupom promocional — publica sem pagar; remova a env no Render para desativar.
COUPON_CODE=

# Desconto vigente em % (inteiro 0-100). Ex: 50 = página por R$9,95.
DISCOUNT_PERCENT=

# Token do painel admin (/api/admin/overview?token=...). Sem env, endpoint some.
ADMIN_TOKEN=

# --- Email do link mágico (SMTP genérico, ex: Resend) ---
# Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key re_...>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Remetente exibido. Precisa ser do domínio verificado. Ex: "Chamego <ola@chamego.online>"
MAIL_FROM=

# Gmail legado (fallback se SMTP_* vazio). Mantido por compatibilidade.
GMAIL_USER=
GMAIL_APP_PASSWORD=
