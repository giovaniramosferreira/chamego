# URL pública do app (ex: https://chamego.onrender.com) — links de convite e link mágico.
PUBLIC_URL=

# Diretório persistente para o SQLite (no Render: /var/data).
DATA_DIR=

# Segredo que assina o cookie de sessão. Sem ele, todo deploy desloga todo mundo.
SESSION_SECRET=

# Google Identity Services — botão "Continuar com Google". Sem ele, só link mágico.
GOOGLE_CLIENT_ID=

# --- Email do link mágico (SMTP genérico, ex: Resend) ---
# Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key re_...>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Remetente exibido. Precisa ser do domínio verificado. Ex: "Chamego <ola@chamego.online>"
MAIL_FROM=

# Gmail legado (fallback se SMTP_* vazio). Mantido por compatibilidade.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Cobrança (Stripe) ---
# Sem estas variáveis o app roda normal: só não vende (a tela de Plano mostra
# "em breve" e o teste grátis continua funcionando).
STRIPE_SECRET_KEY=
# Segredo do endpoint /api/billing/webhook (stripe listen / dashboard).
STRIPE_WEBHOOK_SECRET=
# IDs de preço criados no painel do Stripe (price_...), em BRL.
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_ANUAL=
# Presente (cobrança única, sem renovar): 3, 6 e 12 meses.
STRIPE_PRICE_PRESENTE_3M=
STRIPE_PRICE_PRESENTE_6M=
STRIPE_PRICE_PRESENTE_12M=
# Pix no plano anual (cobrança única). Deixe 1 para habilitar.
STRIPE_PIX=

# Chave de operação: cortesias (x-admin-key no PATCH /api/subscription) e
# métricas do funil (GET /api/admin/metrics). Sem ela, ambos ficam fechados.
ADMIN_KEY=
